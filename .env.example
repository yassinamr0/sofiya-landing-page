# The application form every "Apply now" button opens: a Typeform, Tally or Google Forms share link.
# Copy this file to .env.local for development, and set the same variable on Vercel.
NEXT_PUBLIC_APPLY_FORM_URL=https://forms.example.com/REPLACE_ME

# Analytics (optional). Unset: nothing is sent. Examples:
#   NEXT_PUBLIC_ANALYTICS=umami:<website id from Umami>
#   NEXT_PUBLIC_ANALYTICS=plausible:<script URL from Plausible's install snippet>
NEXT_PUBLIC_ANALYTICS=
